# Copia este archivo como ".env" y ajusta los valores.
# El archivo .env NUNCA se sube a GitHub.

# Ruta a la clave de la cuenta de servicio de Firebase
FIREBASE_CREDENTIALS=serviceAccount.json

# Solo para pruebas locales sin la app: si es "true", el backend
# no pide token de Firebase y usa el usuario de prueba "dev-user".
# En Render debe quedar en "false".
AUTH_DISABLED=false

# Clave de la API de Gemini (Google AI Studio). Si esta vacia, el backend
# funciona igual pero sin consejos de IA (solo reglas de salud).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
